{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portrait Batch Edit Plan",
  "type": "object",
  "required": [
    "schema_version",
    "style_groups",
    "photos"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "created_at": {
      "type": "string"
    },
    "global_style_summary": {
      "type": "string"
    },
    "style_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "style_name",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "style_name": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "lighting": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_path",
          "preview_path",
          "style_group",
          "global_settings"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "preview_path": {
            "type": "string"
          },
          "style_group": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "global_settings": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "local_adjustments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "status",
                "instruction"
              ],
              "properties": {
                "target": {
                  "enum": [
                    "subject",
                    "facial_skin",
                    "iris_pupil",
                    "hair",
                    "background"
                  ]
                },
                "status": {
                  "const": "proposed_not_applied"
                },
                "instruction": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "observation": {
                  "type": "string"
                },
                "stop_when": {
                  "type": "string"
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "notes": {
            "type": "string"
          },
          "preview": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
